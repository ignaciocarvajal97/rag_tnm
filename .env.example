# Ruta al directorio del catálogo (YAML/MD)
RAG_CATALOG_DIR=data/catalog

# Persistencia ChromaDB (se crea al hacer ingest)
RAG_CHROMA_PATH=data/chroma

# Nombre de la colección
RAG_COLLECTION_NAME=dw_catalog

# Ollama (local): modelo por defecto gemma3:12b (ollama pull gemma3:12b ~ 8 GB).
# Otras alternativas razonables tras ollama pull:
#   - gemma3:4b           (ligero, ~3 GB; baja calidad SQL)
#   - gemma3:27b          (top calidad Gemma; ~17 GB de RAM)
#   - qwen2.5-coder:7b    (especializado en codigo/SQL; ~5 GB)
#   - qwen2.5-coder:14b   (top calidad SQL local; ~9 GB)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma3:12b
OLLAMA_NUM_CTX=8192
OLLAMA_TIMEOUT_S=180

# PostgreSQL destino (si no están aquí, se leen del .env en la raíz del repo datawarehouse_tnm)
# DEST_DB_HOST=
# DEST_DB_PORT=5432
# DEST_DB_NAME=
# DEST_DB_USER=
# DEST_DB_PASSWORD=

# Opcional: OpenAI (pip install -e ".[llm]")
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
